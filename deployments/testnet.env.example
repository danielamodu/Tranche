# HashKey Chain Testnet (Chain ID 133) Deployment & Lifecycle Configuration
# Copy to `.env` (gitignored) and populate with your own testnet keys before running --broadcast.
# NEVER commit real private keys.

# --- 1. Deployer (fund with >= 0.25 HSK on Chain 133) ---
DEPLOYER_PRIVATE_KEY=0x

# --- 2. Governance Safe (3-of-5, all 5 addresses MUST be distinct) ---
GOV_OWNER_1=0x
GOV_OWNER_2=0x
GOV_OWNER_3=0x
GOV_OWNER_4=0x
GOV_OWNER_5=0x

# --- 3. Security Guardian Safe (2-of-3, all 3 addresses MUST be distinct) ---
GUARDIAN_OWNER_1=0x
GUARDIAN_OWNER_2=0x
GUARDIAN_OWNER_3=0x

# --- 4. Treasury Safe (2-of-3, all 3 addresses MUST be distinct) ---
TREASURY_OWNER_1=0x
TREASURY_OWNER_2=0x
TREASURY_OWNER_3=0x

# --- 5. M-of-N SignedPullOracle Signers (2-of-3, all 3 addresses MUST be distinct) ---
ORACLE_SIGNER_1=0x
ORACLE_SIGNER_2=0x
ORACLE_SIGNER_3=0x

# --- 6. HSP Compliance Attestation Signer ---
HSP_ATTESTATION_SIGNER=0x

# --- 7. Optional Overrides ---
TIMELOCK_MIN_DELAY=60
SAFE_SALT_NONCE_BASE=13320260001

# --- 8. Post-Deploy Ownership Handover (3 of the 5 GOV_OWNER private keys) ---
GOV_SIGNER_PK_1=0x
GOV_SIGNER_PK_2=0x
GOV_SIGNER_PK_3=0x
GOV_SAFE_ADDRESS=0x
TIMELOCK_ADDRESS=0x
VAULT_ADDRESS=0x
MANAGER_ADDRESS=0x
PULL_ORACLE_ADDRESS=0x
ORACLE_ADAPTER_ADDRESS=0x
TWAP_ORACLE_ADDRESS=0x
COMPLIANCE_HOOK_ADDRESS=0x

# --- 9. Live Lifecycle Demo (Separate LP & Trader Accounts) ---
LP_PRIVATE_KEY=0x
TRADER_PRIVATE_KEY=0x
