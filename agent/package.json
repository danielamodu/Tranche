{
  "name": "@tranche/agent",
  "version": "0.1.0",
  "description": "Deterministic execution agent and decision-trace tooling for Tranche",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/agent.integration.test.ts test/autonomous.test.ts test/server.test.ts test/operations.test.ts test/soak.test.ts test/hsp-payments.test.ts test/intelligence.test.ts",
    "test:intelligence": "node --import tsx --test test/intelligence.test.ts",
    "test:hsp-payments": "node --import tsx --test test/hsp-payments.test.ts",
    "test:soak": "node --import tsx --test test/soak.test.ts",
    "test:chain177": "node --import tsx --test test/chain177.readonly.test.ts",
    "test:fork": "node --import tsx --test test/fork.integration.test.ts",
    "test:fork:regression": "node --import tsx --test test/fork.regression.test.ts",
    "bench:chain177": "tsx src/benchmark-chain177.ts",
    "api": "tsx src/start-api.ts",
    "demo": "tsx src/run-demo.ts",
    "soak:24h": "tsx src/start-soak.ts --hours 24",
    "soak:48h": "tsx src/start-soak.ts --hours 48",
    "soak:72h": "tsx src/start-soak.ts --hours 72",
    "soak:stop": "tsx src/stop-soak.ts",
    "soak:inspect": "tsx src/inspect-soak.ts"
  },
  "dependencies": {
    "@tranche/sdk": "file:../sdk",
    "viem": "^2.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
